---
import BaseLayout from './BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  lead: string;
  breadcrumb: string;
  section: string;
  lastUpdated: string;
}

const { title, description, eyebrow, heading, lead, breadcrumb, section, lastUpdated } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <Navbar />

  <header class="legal-hero" data-section={`${section}-hero`} data-screen-label={`${breadcrumb} hero`}>
    <div class="hero-container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Inicio</a>
        <span aria-hidden="true">/</span>
        <span class="is-current">{breadcrumb}</span>
      </nav>

      <div class="hero-content">
        <Eyebrow text={eyebrow} inverse />
        <h1 class="hero-title">{heading}</h1>
        <p class="hero-lead">{lead}</p>
      </div>
    </div>
  </header>

  <main class="legal-main" data-section={`${section}-contenido`}>
    <div class="legal-container">
      <p class="legal-updated">Última actualización: {lastUpdated}</p>
      <slot />
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .legal-hero {
    position: relative;
    padding-block: clamp(96px, 10vw, 140px) clamp(48px, 6vw, 80px);
    background: var(--color-lake-800);
    color: var(--color-sand-50);
  }

  .hero-container {
    max-width: 820px;
    margin: 0 auto;
    padding-inline: var(--gutter);
  }

  .breadcrumb {
    display: flex;
    gap: 10px;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(250, 248, 243, 0.55);
    margin-bottom: 40px;
  }

  .breadcrumb a {
    color: inherit;
    text-decoration: none;
    transition: color var(--duration-3, 200ms) var(--ease-out);
  }

  .breadcrumb a:hover {
    color: var(--color-sand-50);
  }

  .breadcrumb .is-current {
    color: var(--color-earth-300);
  }

  .hero-content {
    display: grid;
    gap: 16px;
  }

  .hero-title {
    margin: 12px 0 0;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.015em;
    color: var(--color-sand-50);
  }

  .hero-lead {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-body-lg);
    line-height: 1.55;
    color: rgba(250, 248, 243, 0.78);
    max-width: 56ch;
  }

  .legal-main {
    background: var(--color-surface);
    padding-block: clamp(48px, 6vw, 80px) clamp(80px, 10vw, 140px);
  }

  .legal-container {
    max-width: 720px;
    margin: 0 auto;
    padding-inline: var(--gutter);
  }

  .legal-updated {
    margin: 0 0 40px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--color-ink-muted);
  }

  /* The page's sections arrive through the slot, outside this component's
     style scope. */
  .legal-container :global(.legal-block) {
    margin-bottom: 40px;
    scroll-margin-top: 96px;
  }

  .legal-container :global(.legal-block h2) {
    margin: 0 0 16px;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    line-height: 1.15;
    color: var(--color-ink);
  }

  .legal-container :global(.legal-block h3) {
    margin: 24px 0 12px;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--text-body-lg);
    line-height: 1.3;
    color: var(--color-ink);
  }

  .legal-container :global(.legal-block p) {
    margin: 0 0 16px;
    font-family: var(--font-serif);
    font-size: var(--text-body);
    line-height: 1.7;
    color: var(--color-ink);
  }

  .legal-container :global(.legal-block ul),
  .legal-container :global(.legal-block ol) {
    margin: 0 0 16px;
    padding-left: 22px;
    display: grid;
    gap: 8px;
  }

  .legal-container :global(.legal-block li) {
    font-family: var(--font-serif);
    font-size: var(--text-body);
    line-height: 1.6;
    color: var(--color-ink);
  }

  .legal-container :global(.legal-block a) {
    color: var(--color-accent-ink, var(--color-earth-500));
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .legal-container :global(.legal-block a:hover) {
    color: var(--color-earth-400);
  }
</style>
