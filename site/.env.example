# ============================================================
# Laguna Escondida — Site (Astro)
# Copy this file to `.env` and fill in the values.
#
# NOTE: Only variables prefixed with PUBLIC_ are exposed to the
# browser. Everything here is public by design (tag/pixel IDs).
# ============================================================

# --- Tag Management & Analytics ---

# Google Tag Manager container ID.
# This is the single entry point for GA4, Google Ads and any other
# tag configured in the GTM dashboard. Format: GTM-XXXXXXX
# If unset, the GTM tag is NOT rendered (no fallback).
PUBLIC_GTM_ID=

# Google Analytics 4 (GA4) — Measurement ID (G-XXXXXXXXXX).
# NOT read directly by the site: GA4 is loaded *inside* GTM as a
# "GA4 Configuration" tag. Keep the ID here only as documentation /
# for whoever configures the GTM container.
# PUBLIC_GA_MEASUREMENT_ID=

# --- Advertising Pixels (optional) ---
# Leave empty to disable the pixel. When empty the script is not
# injected at all (see site/src/layouts/BaseLayout.astro).

# Meta (Facebook / Instagram) Pixel ID — numeric string.
# Source: Meta Events Manager.
PUBLIC_META_PIXEL_ID=

# TikTok Pixel ID.
# Source: TikTok Events Manager.
PUBLIC_TIKTOK_PIXEL_ID=

# --- Contact ---

# WhatsApp Business number — full number with country code, no spaces
# or symbols (e.g. 573001234567). Used to build all wa.me links.
PUBLIC_WHATSAPP_NUMBER=
