#!/usr/bin/env bash
# Full gate before pushing: run the exact CI pipeline
# (install + lint/types + build + static analytics validation).
# Slower than pre-commit, but push is less frequent — and this is the last
# line of defense before the Cloudflare build runs the same commands.
#
# Skip in an emergency with:  git push --no-verify
set -euo pipefail

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$(git rev-parse --show-toplevel)"
# shellcheck source=/dev/null
. "$HOOK_DIR/common.sh"

echo "── pre-push: mirroring the full CI build ──"
run_install_check     # deps install exactly like CI
run_lint_check        # astro check (types + templates) on site + funnel
run_build_check       # node build.mjs → deploy/
run_analytics_check   # static tracking-attribute validation on deploy/
echo "✔ pre-push checks passed — safe to push"
