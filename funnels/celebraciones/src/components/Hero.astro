---
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';
import { hero } from '../data/funnel';
---

<!-- Dark lake band. When the hero photo lands, it goes behind the glow layer
     as a full-bleed image; the glow becomes the scrim that keeps text legible. -->
<section data-section="hero" class="on-dark relative w-full overflow-hidden"
  style="background-color: var(--color-surface-inverse); padding: 4.5rem 0 4rem;">

  <div class="absolute inset-0" aria-hidden="true"
    style="background:
             radial-gradient(ellipse 80% 60% at 50% 0%, rgb(79 132 120 / 0.35), transparent 70%),
             linear-gradient(180deg, transparent 60%, rgb(7 19 14 / 0.45));">
  </div>

  <div class="section-wrapper relative" style="padding-top: 0; padding-bottom: 0;">
    <div class="max-w-3xl mx-auto text-center">

      {hero.credibilityPill && (
        <div class="inline-flex flex-wrap items-center justify-center gap-x-2 gap-y-1 px-4 py-2
                    rounded-full text-sm font-medium mb-7"
          style="border: 1px solid rgb(244 240 231 / 0.25); color: var(--color-on-inverse);">
          {hero.credibilityPill.map((item, i) => (
            <>
              {i > 0 && <span aria-hidden="true" style="color: var(--color-gold-light);">·</span>}
              <span class="inline-flex items-center gap-1.5">
                <span style="color: var(--color-gold-light);"><Icon name={item.icon} size={16} /></span>
                {item.text}
              </span>
            </>
          ))}
        </div>
      )}

      <h1 class="mb-6"
        style="font-size: clamp(2.25rem, 6vw, 3.75rem); line-height: 1.08;">
        {hero.headline}
      </h1>

      <p class="mb-9 max-w-2xl mx-auto"
        style="font-size: var(--text-xl); color: var(--color-on-inverse-muted); line-height: 1.6;">
        {hero.subheadline}
      </p>

      <div class="flex flex-col sm:flex-row gap-3 justify-center items-center">
        <Button href={hero.ctaHref} variant="whatsapp" size="lg" target="_blank"
          data-event="funnel_whatsapp_click" data-location="hero">
          <Icon name="message-circle" />
          {hero.ctaText}
        </Button>
        {hero.secondaryCta && (
          <Button href={hero.secondaryHref} variant="ghost" size="lg"
            class="text-[var(--color-on-inverse)] underline decoration-[var(--color-gold)] decoration-1 underline-offset-8">
            {hero.secondaryCta}
          </Button>
        )}
      </div>

      {hero.trustNote && (
        <p class="mt-5 text-sm inline-flex items-center gap-1.5" style="color: var(--color-on-inverse-muted);">
          <Icon name="shield-check" size={16} />
          {hero.trustNote}
        </p>
      )}

    </div>

    {hero.stats && hero.stats.length > 0 && (
      <div class="mt-14 pt-10 grid grid-cols-2 md:grid-cols-4 gap-y-8 gap-x-6 max-w-3xl mx-auto"
        style="border-top: 1px solid rgb(197 169 97 / 0.35);">
        {hero.stats.map((stat) => (
          <div class="text-center">
            <div class="text-3xl mb-1"
              style="font-family: var(--font-heading); font-weight: 600; color: var(--color-gold-light);">
              {stat.value}
            </div>
            <div class="text-sm" style="color: var(--color-on-inverse-muted);">
              {stat.label}
            </div>
          </div>
        ))}
      </div>
    )}

  </div>
</section>
