---
import Button from './ui/Button.astro';
import SectionWrapper from './ui/SectionWrapper.astro';
import Icon from './ui/Icon.astro';
import { offer } from '../data/funnel';
---

<SectionWrapper id="paquetes" data-section="offer" background="default">
  <div class="max-w-5xl mx-auto">

    <p class="section-label text-center mb-3">{offer.eyebrow}</p>
    <h2 class="text-3xl md:text-4xl font-bold text-center mb-4">
      {offer.headline}
    </h2>
    <p class="text-lg text-center mb-14 max-w-2xl mx-auto"
      style="color: var(--color-neutral-700);">
      {offer.subheadline}
    </p>

    <!-- Packages grid -->
    <div class="grid md:grid-cols-3 gap-6 mb-10">
      {offer.packages.map((pkg) => (
        <div
          class={`flex flex-col rounded-lg overflow-hidden ${
            pkg.highlighted ? 'ring-2 ring-[var(--color-accent)] shadow-lg md:-translate-y-2' : ''
          }`}
          style={`border: 1px solid var(--color-border); background: var(--color-card);
                  ${pkg.highlighted ? 'border-color: var(--color-accent);' : ''}`}
        >
          {pkg.highlighted && (
            <div class="px-4 py-2 text-center text-xs font-semibold uppercase text-white"
              style="background: var(--color-accent); letter-spacing: 0.18em;">
              Más popular
            </div>
          )}

          <div class="p-6 flex flex-col flex-1">
            <h3 class="text-xl font-bold mb-1" style="color: var(--color-neutral-900);">
              {pkg.name}
            </h3>
            <div class="mb-1">
              <span class="text-3xl" style="font-family: var(--font-heading); font-weight: 600; color: var(--color-accent);">
                {pkg.price}
              </span>
              <span class="text-sm ml-1" style="color: var(--color-neutral-500);">COP</span>
            </div>
            <p class="text-sm mb-1 font-medium" style="color: var(--color-accent-dark);">
              {pkg.capacity}
            </p>
            <p class="text-sm mb-4" style="color: var(--color-neutral-600);">
              {pkg.description}
            </p>

            <ul class="space-y-2 mb-6 flex-1">
              {pkg.features.map((feature) => (
                <li class="flex items-start gap-2 text-sm">
                  <span class="mt-0.5" style="color: var(--color-primary);"><Icon name="check" size={16} /></span>
                  <span style="color: var(--color-neutral-700);">{feature}</span>
                </li>
              ))}
            </ul>

            <p class="text-xs mb-4" style="color: var(--color-neutral-500);">
              Ideal para: {pkg.idealFor}
            </p>

            <Button
              href={offer.ctaHref}
              variant={pkg.highlighted ? 'whatsapp' : 'primary'}
              size="md"
              target="_blank"
              class="w-full"
              data-event="funnel_whatsapp_click"
              data-location={`offer-${pkg.name.toLowerCase().replace(/\s+/g, '-')}`}
            >
              <Icon name="message-circle" />
              {offer.ctaText}
            </Button>
          </div>
        </div>
      ))}
    </div>

    <!-- Bonuses -->
    <div class="rounded-lg p-6"
      style="background: var(--color-primary-light); border: 1px solid var(--color-border);">
      <h3 class="font-bold mb-3 text-center" style="color: var(--color-primary);">
        Incluido en TODOS los paquetes:
      </h3>
      <div class="grid md:grid-cols-2 gap-4 max-w-3xl mx-auto">
        {offer.bonuses.map((bonus) => (
          <p class="flex items-start gap-2 font-medium"
            style="color: var(--color-neutral-700);">
            <span class="mt-0.5" style="color: var(--color-primary);"><Icon name={bonus.icon} /></span>
            {bonus.text}
          </p>
        ))}
      </div>
    </div>

    {offer.guarantee && (
      <p class="mt-6 flex items-center justify-center gap-1.5 text-sm" style="color: var(--color-neutral-500);">
        <Icon name="shield-check" size={16} />
        {offer.guarantee}
      </p>
    )}

  </div>
</SectionWrapper>
