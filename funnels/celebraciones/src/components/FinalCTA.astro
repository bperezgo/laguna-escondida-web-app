---
import Button from './ui/Button.astro';
import SectionWrapper from './ui/SectionWrapper.astro';
import Icon from './ui/Icon.astro';
import { finalCta } from '../data/funnel';
---

<SectionWrapper id="reservar" data-section="final-cta" background="dark">
  <div class="max-w-3xl mx-auto text-center">

    <h2 class="text-3xl md:text-5xl font-bold mb-6"
      style="line-height: 1.1;">
      {finalCta.headline}
    </h2>

    <p class="text-lg mb-10" style="color: var(--color-on-inverse-muted);">
      {finalCta.subheadline}
    </p>

    <Button href={finalCta.ctaHref} variant="whatsapp" size="lg" target="_blank"
      data-event="funnel_whatsapp_click" data-location="final-cta">
      <Icon name="message-circle" />
      {finalCta.ctaText}
    </Button>

    {finalCta.guarantee && (
      <p class="mt-6 text-sm inline-flex items-center gap-1.5" style="color: var(--color-on-inverse-muted);">
        <Icon name="shield-check" size={16} />
        {finalCta.guarantee}
      </p>
    )}

  </div>
</SectionWrapper>
